ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flaskセッション署名鍵（本番では必ず長いランダム文字列を設定）
SECRET_KEY=change-me-to-a-long-random-string

# WebAuthn設定（ローカル開発はデフォルト値でOK）
RP_ID=localhost
APP_ORIGIN=http://localhost:8080

# Render本番デプロイ時の設定例:
# RP_ID=your-app-name.onrender.com
# APP_ORIGIN=https://your-app-name.onrender.com

# Supabase接続（Renderデプロイ時に設定）
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
